<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Veloq.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:Veloq.Views"
        mc:Ignorable="d" d:DesignWidth="1300" d:DesignHeight="820"
        x:Class="Veloq.Views.MainWindow"
        Icon="/Assets/avalonia-logo.ico"
        Width="1300" Height="820" MinWidth="900" MinHeight="600"
        TransparencyLevelHint="None"
        Background="#0a0e14"
        Title="Veloq — LINQ Playground">
        <views:MainView />
</Window>
